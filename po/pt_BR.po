#: gnomeCustom@gfiamoncini.com/prefs/widgets.js:297
msgid "Disabled"
msgstr "Desativado"

#: gnomeCustom@gfiamoncini.com/prefs/widgets.js:304
msgid "Restore default"
msgstr "Restaurar padrão"

#: gnomeCustom@gfiamoncini.com/prefs/widgets.js:310
msgid "Disable shortcut"
msgstr "Desativar atalho"

#: gnomeCustom@gfiamoncini.com/prefs/widgets.js:328
#, javascript-format
msgid "Also used by “%s” (%s)"
msgstr "Também usado por “%s” (%s)"

#: gnomeCustom@gfiamoncini.com/prefs/widgets.js:345
msgid "Press the new shortcut. Esc cancels, Backspace disables."
msgstr "Pressione o novo atalho. Esc cancela, Backspace desativa."

#: gnomeCustom@gfiamoncini.com/prefs/widgets.js:347
#: gnomeCustom@gfiamoncini.com/prefs/pages/general.js:137
msgid "Cancel"
msgstr "Cancelar"

#: gnomeCustom@gfiamoncini.com/prefs/widgets.js:356
msgid ""
"Use Ctrl, Alt or Super with the key (function and media keys work alone)."
msgstr "Use Ctrl, Alt ou Super com a tecla (teclas de função e de mídia valem sozinhas)."

#: gnomeCustom@gfiamoncini.com/prefs/pages/general.js:23
msgid "Silent"
msgstr "Silencioso"

#: gnomeCustom@gfiamoncini.com/prefs/pages/general.js:24
msgid "Errors only"
msgstr "Apenas erros"

#: gnomeCustom@gfiamoncini.com/prefs/pages/general.js:25
msgid "Warnings"
msgstr "Avisos"

#: gnomeCustom@gfiamoncini.com/prefs/pages/general.js:26
msgid "Info"
msgstr "Informação"

#: gnomeCustom@gfiamoncini.com/prefs/pages/general.js:27
msgid "Debug"
msgstr "Depuração"

#: gnomeCustom@gfiamoncini.com/prefs/pages/general.js:51
msgid "General"
msgstr "Geral"

#: gnomeCustom@gfiamoncini.com/prefs/pages/general.js:74
#: gnomeCustom@gfiamoncini.com/prefs/pages/general.js:86
msgid "Profile"
msgstr "Perfil"

#: gnomeCustom@gfiamoncini.com/prefs/pages/general.js:75
msgid "Turns modules on or off and picks a theme in one step."
msgstr "Liga ou desliga módulos e escolhe um tema de uma vez."

#: gnomeCustom@gfiamoncini.com/prefs/pages/general.js:83
#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:55
msgid "Custom"
msgstr "Personalizado"

#: gnomeCustom@gfiamoncini.com/prefs/pages/general.js:96
msgid "Your own combination of modules and settings"
msgstr "A sua própria combinação de módulos e ajustes"

#: gnomeCustom@gfiamoncini.com/prefs/pages/general.js:134
msgid "Original extensions are still active"
msgstr "Extensões originais ainda estão ativas"

#: gnomeCustom@gfiamoncini.com/prefs/pages/general.js:135
#, javascript-format
msgid ""
"%s would run alongside the modules that replace them. Disable them in the "
"Extensions app first, or apply anyway and disable them afterwards."
msgstr ""
"%s rodariam junto com os módulos que as substituem. Desative-as antes no "
"aplicativo Extensões, ou aplique assim mesmo e desative-as depois."

#: gnomeCustom@gfiamoncini.com/prefs/pages/general.js:138
msgid "Apply anyway"
msgstr "Aplicar assim mesmo"

#: gnomeCustom@gfiamoncini.com/prefs/pages/general.js:156
msgid "Modules"
msgstr "Módulos"

#: gnomeCustom@gfiamoncini.com/prefs/pages/general.js:157
msgid ""
"Each module can be turned on or off on its own. Turning the extension off "
"restores the previous state of GNOME."
msgstr ""
"Cada módulo pode ser ativado ou desativado individualmente. Desativar a "
"extensão restaura o estado anterior do GNOME."

#: gnomeCustom@gfiamoncini.com/prefs/pages/general.js:170
#, javascript-format
msgid "not implemented yet, arrives in phase %d"
msgstr "ainda não implementado, chega na fase %d"

#: gnomeCustom@gfiamoncini.com/prefs/pages/general.js:192
msgid "Logging"
msgstr "Registro"

#: gnomeCustom@gfiamoncini.com/prefs/pages/general.js:193
msgid "Messages are written to the systemd journal, tagged [GnomeCustom]."
msgstr ""
"As mensagens são gravadas no journal do systemd, com o marcador "
"[GnomeCustom]."

#: gnomeCustom@gfiamoncini.com/prefs/pages/general.js:201
msgid "Detail level"
msgstr "Nível de detalhe"

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:24
#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:388
#: gnomeCustom@gfiamoncini.com/lib/modules-info.js:37
msgid "Theme"
msgstr "Tema"

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:47
msgid "Preset"
msgstr "Predefinição"

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:48
msgid ""
"A starting point for every surface at once. Changing any option below turns "
"it into a custom look."
msgstr ""
"Um ponto de partida para todas as superfícies de uma vez. Mudar qualquer "
"opção abaixo transforma o visual em personalizado."

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:58
msgid "Look"
msgstr "Visual"

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:69
msgid "Your own combination of the options below"
msgstr "A sua própria combinação das opções abaixo"

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:98
msgid "Menus, OSD and dock"
msgstr "Menus, OSD e dock"

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:99
msgid ""
"Extends the bar colours to other surfaces. Each one keeps the look of the "
"shell theme until turned on."
msgstr ""
"Estende as cores da barra a outras superfícies. Cada uma mantém o visual do "
"tema do Shell até ser ligada."

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:103
msgid "Style popup menus"
msgstr "Estilizar os menus"

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:104
msgid "Panel menus, the logo menu, the applications menu and the cards"
msgstr "Menus do painel, o menu do logotipo, o menu de aplicações e os cartões"

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:109
msgid "Style on-screen displays"
msgstr "Estilizar os avisos na tela (OSD)"

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:110
msgid "Volume and brightness pop-ups; the level bar takes the accent"
msgstr "Avisos de volume e brilho; a barra de nível usa a cor de destaque"

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:115
msgid "Style the dock"
msgstr "Estilizar o dock"

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:116
msgid ""
"Background colour and running indicators; opacity stays in the dock settings"
msgstr ""
"Cor de fundo e indicadores de execução; a opacidade continua nas "
"configurações do dock"

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:121
msgid "Menu and OSD corner radius"
msgstr "Raio dos cantos de menus e OSD"

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:130
msgid "Menu and OSD opacity"
msgstr "Opacidade de menus e OSD"

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:139
msgid "Dock corner radius"
msgstr "Raio dos cantos do dock"

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:154
msgid "Tiling borders"
msgstr "Bordas do mosaico"

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:155
msgid ""
"Border of the focused window. Used by the tiling module, which is not "
"implemented yet."
msgstr ""
"Borda da janela em foco. Usada pelo módulo de mosaico, que ainda não foi "
"implementado."

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:159
msgid "Border colour"
msgstr "Cor da borda"

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:160
msgid "Clear to follow the accent colour"
msgstr "Limpe para seguir a cor de destaque"

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:167
#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:219
msgid "Border thickness"
msgstr "Espessura da borda"

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:174
msgid "Border corner radius"
msgstr "Raio dos cantos da borda"

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:187
#: gnomeCustom@gfiamoncini.com/prefs/pages/bluetooth.js:25
#: gnomeCustom@gfiamoncini.com/prefs/pages/media.js:146
msgid "Top bar"
msgstr "Barra superior"

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:188
msgid ""
"Shape and position of the top bar. “None” leaves the shell theme in charge."
msgstr ""
"Forma e posição da barra superior. “Nenhum” deixa o tema do Shell no comando."

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:192
msgid "Style"
msgstr "Estilo"

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:196
msgid "None"
msgstr "Nenhum"

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:197
msgid "Attached to the edge"
msgstr "Encostada na borda"

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:198
msgid "Floating"
msgstr "Flutuante"

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:202
msgid "Height"
msgstr "Altura"

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:203
#: gnomeCustom@gfiamoncini.com/prefs/pages/menu.js:51
msgid "In pixels"
msgstr "Em pixels"

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:210
msgid "Corner radius"
msgstr "Raio dos cantos"

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:228
msgid "Space above"
msgstr "Espaço acima"

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:237
msgid "Space below"
msgstr "Espaço abaixo"

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:246
msgid "Space at the sides"
msgstr "Espaço nas laterais"

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:255
msgid "Full-height panel buttons"
msgstr "Botões com a altura toda da barra"

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:256
msgid "Removes the padding above and below buttons so they fill the bar"
msgstr ""
"Remove o espaçamento acima e abaixo dos botões, para que ocupem a barra "
"inteira"

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:267
msgid "Colours"
msgstr "Cores"

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:268
msgid ""
"With the wallpaper palette on, the bar takes its background from the desktop "
"background. Setting a background colour below overrides it."
msgstr ""
"Com a paleta do papel de parede ligada, o fundo da barra vem da imagem da "
"área de trabalho. Definir uma cor de fundo abaixo tem precedência."

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:272
msgid "Take colours from the wallpaper"
msgstr "Usar as cores do papel de parede"

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:277
msgid "Palette colour to use"
msgstr "Cor da paleta a usar"

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:278
msgid "0 is the most frequent colour of the wallpaper"
msgstr "0 é a cor mais frequente do papel de parede"

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:285
#: gnomeCustom@gfiamoncini.com/prefs/pages/dock.js:48
