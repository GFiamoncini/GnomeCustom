#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:310
msgid "Background colour"
msgstr "Cor de fundo"

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:311
msgid "Clear to go back to the wallpaper palette"
msgstr "Limpe para voltar à paleta do papel de parede"

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:318
msgid "Text colour"
msgstr "Cor do texto"

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:319
