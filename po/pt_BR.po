#: gnomeCustom@gfiamoncini.com/prefs/pages/menu.js:77
msgid "Monochrome"
msgstr "Monocromático"

#: gnomeCustom@gfiamoncini.com/prefs/pages/menu.js:122
msgid "From the distribution"
