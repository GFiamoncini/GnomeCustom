#: gnomeCustom@gfiamoncini.com/prefs/pages/general.js:20
msgid "Silent"
msgstr "Silencioso"

#: gnomeCustom@gfiamoncini.com/prefs/pages/general.js:21
msgid "Errors only"
msgstr "Apenas erros"

#: gnomeCustom@gfiamoncini.com/prefs/pages/general.js:22
msgid "Warnings"
msgstr "Avisos"

#: gnomeCustom@gfiamoncini.com/prefs/pages/general.js:23
msgid "Info"
msgstr "Informação"

#: gnomeCustom@gfiamoncini.com/prefs/pages/general.js:24
msgid "Debug"
msgstr "Depuração"

#: gnomeCustom@gfiamoncini.com/prefs/pages/general.js:42
msgid "General"
msgstr "Geral"

#: gnomeCustom@gfiamoncini.com/prefs/pages/general.js:55
msgid "Modules"
msgstr "Módulos"

#: gnomeCustom@gfiamoncini.com/prefs/pages/general.js:56
msgid ""
"Each module can be turned on or off on its own. Turning the extension off "
"restores the previous state of GNOME."
msgstr ""
"Cada módulo pode ser ativado ou desativado individualmente. Desativar a "
"extensão restaura o estado anterior do GNOME."

#: gnomeCustom@gfiamoncini.com/prefs/pages/general.js:69
#, javascript-format
msgid "not implemented yet, arrives in phase %d"
msgstr "ainda não implementado, chega na fase %d"

#: gnomeCustom@gfiamoncini.com/prefs/pages/general.js:91
msgid "Logging"
msgstr "Registro"

#: gnomeCustom@gfiamoncini.com/prefs/pages/general.js:92
msgid "Messages are written to the systemd journal, tagged [GnomeCustom]."
msgstr ""
"As mensagens são gravadas no journal do systemd, com o marcador "
"[GnomeCustom]."

#: gnomeCustom@gfiamoncini.com/prefs/pages/general.js:100
msgid "Detail level"
msgstr "Nível de detalhe"

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:21
#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:237
msgid "Theme"
msgstr "Tema"

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:36
#: gnomeCustom@gfiamoncini.com/prefs/pages/bluetooth.js:25
#: gnomeCustom@gfiamoncini.com/prefs/pages/media.js:141
msgid "Top bar"
msgstr "Barra superior"

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:37
msgid ""
"Shape and position of the top bar. “None” leaves the shell theme in charge."
msgstr ""
"Forma e posição da barra superior. “Nenhum” deixa o tema do Shell no comando."

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:41
msgid "Style"
msgstr "Estilo"

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:45
msgid "None"
msgstr "Nenhum"

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:46
msgid "Attached to the edge"
msgstr "Encostada na borda"

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:47
msgid "Floating"
msgstr "Flutuante"

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:51
msgid "Height"
msgstr "Altura"

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:52
#: gnomeCustom@gfiamoncini.com/prefs/pages/menu.js:51
msgid "In pixels"
msgstr "Em pixels"

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:59
msgid "Corner radius"
msgstr "Raio dos cantos"

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:68
msgid "Border thickness"
msgstr "Espessura da borda"

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:77
msgid "Space above"
msgstr "Espaço acima"

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:86
msgid "Space below"
msgstr "Espaço abaixo"

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:95
msgid "Space at the sides"
msgstr "Espaço nas laterais"

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:104
msgid "Full-height panel buttons"
msgstr "Botões com a altura toda da barra"

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:105
msgid "Removes the padding above and below buttons so they fill the bar"
msgstr ""
"Remove o espaçamento acima e abaixo dos botões, para que ocupem a barra "
"inteira"

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:116
msgid "Colours"
msgstr "Cores"

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:117
msgid ""
"With the wallpaper palette on, the bar takes its background from the desktop "
"background. Setting a background colour below overrides it."
msgstr ""
"Com a paleta do papel de parede ligada, o fundo da barra vem da imagem da "
"área de trabalho. Definir uma cor de fundo abaixo tem precedência."

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:121
msgid "Take colours from the wallpaper"
msgstr "Usar as cores do papel de parede"

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:126
msgid "Palette colour to use"
msgstr "Cor da paleta a usar"

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:127
msgid "0 is the most frequent colour of the wallpaper"
msgstr "0 é a cor mais frequente do papel de parede"

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:134
#: gnomeCustom@gfiamoncini.com/prefs/pages/dock.js:48
msgid "Background opacity"
msgstr "Opacidade do fundo"

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:143
#: gnomeCustom@gfiamoncini.com/schemas/org.gnome.shell.extensions.gnomecustom.theme.gschema.xml:58
msgid "Border opacity"
msgstr "Opacidade da borda"

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:152
#: gnomeCustom@gfiamoncini.com/schemas/org.gnome.shell.extensions.gnomecustom.theme.gschema.xml:67
msgid "Accent colour"
msgstr "Cor de destaque"

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:153
msgid "Highlights and open menus"
msgstr "Destaques e menus abertos"

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:159
msgid "Background colour"
msgstr "Cor de fundo"

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:160
msgid "Clear to go back to the wallpaper palette"
msgstr "Limpe para voltar à paleta do papel de parede"

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:167
msgid "Text colour"
msgstr "Cor do texto"

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:168
msgid "Clear to pick automatically for contrast"
msgstr "Limpe para escolher automaticamente por contraste"

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:176
msgid "Current wallpaper palette"
msgstr "Paleta do papel de parede atual"

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:177
msgid "Extracted automatically, most frequent colour first."
msgstr "Extraída automaticamente, da cor mais frequente para a menos."

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:202
msgid "No palette yet"
msgstr "Ainda sem paleta"

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:203
msgid "It is extracted when the Theme module is enabled"
msgstr "É extraída quando o módulo Tema é ativado"

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:213
msgid "most frequent"
msgstr "mais frequente"

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:223
msgid "Shell theme"
msgstr "Tema do Shell"

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:224
msgid ""
"Loads a theme from ~/.themes, the job the User Themes extension does. The "
"generated bar style is applied on top of it."
msgstr ""
"Carrega um tema de ~/.themes, o papel da extensão User Themes. O estilo "
"gerado para a barra é aplicado por cima dele."

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:230
msgid "Default GNOME theme"
msgstr "Tema padrão do GNOME"

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:234
msgid "(not installed)"
msgstr "(não instalado)"

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:245
msgid "Could not list installed themes"
msgstr "Não foi possível listar os temas instalados"

#: gnomeCustom@gfiamoncini.com/prefs/pages/panel.js:20
msgid "Panel"
msgstr "Painel"

#: gnomeCustom@gfiamoncini.com/prefs/pages/panel.js:24
msgid "Applications menu"
msgstr "Menu de aplicações"

#: gnomeCustom@gfiamoncini.com/prefs/pages/panel.js:27
#: gnomeCustom@gfiamoncini.com/schemas/org.gnome.shell.extensions.gnomecustom.panel.gschema.xml:16
msgid "Show the applications menu"
msgstr "Mostrar o menu de aplicações"

#: gnomeCustom@gfiamoncini.com/prefs/pages/panel.js:28
msgid "Categories on the left, applications on the right"
msgstr "Categorias à esquerda, aplicações à direita"

#: gnomeCustom@gfiamoncini.com/prefs/pages/panel.js:33
msgid "Icon size"
msgstr "Tamanho do ícone"

#: gnomeCustom@gfiamoncini.com/prefs/pages/panel.js:40
msgid "Keyboard shortcut"
msgstr "Atalho de teclado"

#: gnomeCustom@gfiamoncini.com/prefs/pages/panel.js:42
msgid "none"
msgstr "nenhum"

#: gnomeCustom@gfiamoncini.com/prefs/pages/panel.js:47
#: gnomeCustom@gfiamoncini.com/prefs/pages/menu.js:125
#: gnomeCustom@gfiamoncini.com/ui/menu/logo-menu.js:115
msgid "Activities"
msgstr "Atividades"

#: gnomeCustom@gfiamoncini.com/prefs/pages/panel.js:49
#: gnomeCustom@gfiamoncini.com/schemas/org.gnome.shell.extensions.gnomecustom.panel.gschema.xml:12
msgid "Show the Activities button"
msgstr "Mostrar o botão Atividades"

#: gnomeCustom@gfiamoncini.com/prefs/pages/panel.js:50
msgid "The logo menu can open the overview instead"
msgstr "O menu do logotipo também abre a visão geral"

#: gnomeCustom@gfiamoncini.com/prefs/pages/menu.js:22
msgid "Logo Menu"
msgstr "Menu do logotipo"

#: gnomeCustom@gfiamoncini.com/prefs/pages/menu.js:36
msgid "Appearance"
msgstr "Aparência"

#: gnomeCustom@gfiamoncini.com/prefs/pages/menu.js:39
msgid "Logo"
msgstr "Logotipo"

#: gnomeCustom@gfiamoncini.com/prefs/pages/menu.js:40
msgid ""
"The distribution logo comes from the system itself, so no images are bundled"
msgstr ""
"O logotipo da distribuição vem do próprio sistema, então nenhuma imagem é "
"embarcada"

#: gnomeCustom@gfiamoncini.com/prefs/pages/menu.js:44
msgid "Distribution logo"
msgstr "Logotipo da distribuição"

#: gnomeCustom@gfiamoncini.com/prefs/pages/menu.js:45
msgid "Monochrome icon"
msgstr "Ícone monocromático"

#: gnomeCustom@gfiamoncini.com/prefs/pages/menu.js:46
msgid "Custom image"
msgstr "Imagem personalizada"

#: gnomeCustom@gfiamoncini.com/prefs/pages/menu.js:50
msgid "Size"
msgstr "Tamanho"

#: gnomeCustom@gfiamoncini.com/prefs/pages/menu.js:65
msgid "Custom image path"
msgstr "Caminho da imagem personalizada"

#: gnomeCustom@gfiamoncini.com/prefs/pages/menu.js:92
msgid "Images"
msgstr "Imagens"

#: gnomeCustom@gfiamoncini.com/prefs/pages/menu.js:96
msgid "Choose a logo image"
msgstr "Escolha uma imagem de logotipo"

#: gnomeCustom@gfiamoncini.com/prefs/pages/menu.js:118
msgid "Menu items"
msgstr "Itens do menu"

#: gnomeCustom@gfiamoncini.com/prefs/pages/menu.js:119
msgid "Turn off what you do not use; separators adjust on their own."
msgstr "Desligue o que não usa; os separadores se ajustam sozinhos."

#: gnomeCustom@gfiamoncini.com/prefs/pages/menu.js:123
#: gnomeCustom@gfiamoncini.com/ui/menu/logo-menu.js:105
msgid "About This System"
msgstr "Sobre este sistema"

#: gnomeCustom@gfiamoncini.com/prefs/pages/menu.js:124
#: gnomeCustom@gfiamoncini.com/ui/menu/logo-menu.js:111
#: gnomeCustom@gfiamoncini.com/ui/panel/apps-menu.js:61
msgid "Applications"
msgstr "Aplicações"

#: gnomeCustom@gfiamoncini.com/prefs/pages/menu.js:126
#: gnomeCustom@gfiamoncini.com/ui/menu/logo-menu.js:123
msgid "Software"
msgstr "Programas"

#: gnomeCustom@gfiamoncini.com/prefs/pages/menu.js:127
#: gnomeCustom@gfiamoncini.com/ui/menu/logo-menu.js:129
msgid "System Monitor"
msgstr "Monitor do sistema"

#: gnomeCustom@gfiamoncini.com/prefs/pages/menu.js:128
#: gnomeCustom@gfiamoncini.com/prefs/pages/menu.js:152
#: gnomeCustom@gfiamoncini.com/ui/menu/logo-menu.js:135
msgid "Terminal"
msgstr "Terminal"

#: gnomeCustom@gfiamoncini.com/prefs/pages/menu.js:129
#: gnomeCustom@gfiamoncini.com/ui/menu/logo-menu.js:140
msgid "Extensions"
msgstr "Extensões"

#: gnomeCustom@gfiamoncini.com/prefs/pages/menu.js:130
#: gnomeCustom@gfiamoncini.com/ui/menu/logo-menu.js:145
msgid "Settings"
msgstr "Configurações"

#: gnomeCustom@gfiamoncini.com/prefs/pages/menu.js:131
msgid "Force Quit a Window"
msgstr "Encerrar uma janela à força"

#: gnomeCustom@gfiamoncini.com/prefs/pages/menu.js:132
#: gnomeCustom@gfiamoncini.com/ui/menu/logo-menu.js:158
msgid "Lock Screen"
msgstr "Bloquear a tela"

#: gnomeCustom@gfiamoncini.com/prefs/pages/menu.js:133
msgid "Suspend, Restart and Power Off"
msgstr "Suspender, reiniciar e desligar"

#: gnomeCustom@gfiamoncini.com/prefs/pages/menu.js:145
msgid "Applications opened by the menu"
msgstr "Aplicações abertas pelo menu"

#: gnomeCustom@gfiamoncini.com/prefs/pages/menu.js:146
msgid "Desktop file identifiers. Leave empty to use the system default."
msgstr ""
"Identificadores de arquivo .desktop. Deixe vazio para usar o padrão do "
"sistema."

#: gnomeCustom@gfiamoncini.com/prefs/pages/menu.js:150
msgid "Software centre"
msgstr "Central de programas"

#: gnomeCustom@gfiamoncini.com/prefs/pages/menu.js:151
msgid "System monitor"
msgstr "Monitor do sistema"

#: gnomeCustom@gfiamoncini.com/prefs/pages/menu.js:153
msgid "Extensions manager"
msgstr "Gerenciador de extensões"

#: gnomeCustom@gfiamoncini.com/prefs/pages/menu.js:183
msgid "This application is not installed"
msgstr "Esta aplicação não está instalada"

#: gnomeCustom@gfiamoncini.com/prefs/pages/bluetooth.js:20
msgid "Bluetooth"
msgstr "Bluetooth"

#: gnomeCustom@gfiamoncini.com/prefs/pages/bluetooth.js:26
msgid ""
"Each connected device appears with its battery. Clicking a device in the "
"card connects or disconnects it."
msgstr ""
"Cada dispositivo conectado aparece com a bateria. Clicar num dispositivo do "
"cartão conecta ou desconecta."

#: gnomeCustom@gfiamoncini.com/prefs/pages/bluetooth.js:29
#: gnomeCustom@gfiamoncini.com/prefs/pages/media.js:144
msgid "Position"
msgstr "Posição"

#: gnomeCustom@gfiamoncini.com/prefs/pages/bluetooth.js:33
#: gnomeCustom@gfiamoncini.com/prefs/pages/media.js:148
msgid "Left"
msgstr "Esquerda"

#: gnomeCustom@gfiamoncini.com/prefs/pages/bluetooth.js:34
#: gnomeCustom@gfiamoncini.com/prefs/pages/media.js:149
msgid "Centre"
msgstr "Centro"

#: gnomeCustom@gfiamoncini.com/prefs/pages/bluetooth.js:35
#: gnomeCustom@gfiamoncini.com/prefs/pages/media.js:150
msgid "Right"
msgstr "Direita"

#: gnomeCustom@gfiamoncini.com/prefs/pages/bluetooth.js:40
msgid "Battery"
msgstr "Bateria"

#: gnomeCustom@gfiamoncini.com/prefs/pages/bluetooth.js:42
msgid "Low battery at or below"
msgstr "Bateria baixa com até"

#: gnomeCustom@gfiamoncini.com/prefs/pages/bluetooth.js:43
msgid "In percent; the device turns red. 0 turns the warning off"
msgstr "Em porcentagem; o dispositivo fica vermelho. 0 desliga o aviso"

#: gnomeCustom@gfiamoncini.com/prefs/pages/media.js:23
msgid "Media"
msgstr "Mídia"

#: gnomeCustom@gfiamoncini.com/prefs/pages/media.js:48
msgid "Players"
msgstr "Reprodutores"

#: gnomeCustom@gfiamoncini.com/prefs/pages/media.js:49
msgid ""
"Only the applications turned on here appear in the top bar. Players open "
"right now are listed automatically; when several play at once, the first one "
"turned on wins."
msgstr ""
"Só as aplicações ligadas aqui aparecem na barra superior. Os reprodutores "
"abertos agora são listados automaticamente; quando vários tocam ao mesmo "
"tempo, vence o primeiro ligado."

#: gnomeCustom@gfiamoncini.com/prefs/pages/media.js:154
msgid "Maximum width of the track name"
msgstr "Largura máxima do nome da faixa"

#: gnomeCustom@gfiamoncini.com/prefs/pages/media.js:155
msgid "In pixels; longer names end with an ellipsis"
msgstr "Em pixels; nomes mais longos terminam em reticências"

#: gnomeCustom@gfiamoncini.com/prefs/pages/media.js:169
msgid "Card"
msgstr "Cartão"

#: gnomeCustom@gfiamoncini.com/prefs/pages/media.js:170
msgid ""
"Opens with a click on the track name. It shows the cover, the track and the "
"artist, without playback controls."
msgstr ""
"Abre com um clique no nome da faixa. Mostra a capa, a faixa e o artista, sem "
"controles de reprodução."

#: gnomeCustom@gfiamoncini.com/prefs/pages/media.js:174
msgid "Show elapsed time"
msgstr "Mostrar o tempo decorrido"

#: gnomeCustom@gfiamoncini.com/prefs/pages/media.js:179
msgid "Background from the album cover"
msgstr "Fundo a partir da capa do álbum"

#: gnomeCustom@gfiamoncini.com/prefs/pages/media.js:180
msgid "When off, the card follows the shell theme"
msgstr "Desligado, o cartão segue o tema do Shell"

#: gnomeCustom@gfiamoncini.com/prefs/pages/dock.js:20
#: gnomeCustom@gfiamoncini.com/prefs/pages/dock.js:25
msgid "Dock"
msgstr "Dock"

#: gnomeCustom@gfiamoncini.com/prefs/pages/dock.js:26
msgid ""
"Always at the bottom of the primary monitor, with favourites and open "
"applications. Maximised windows stop above it."
msgstr ""
"Sempre no rodapé do monitor principal, com os favoritos e as aplicações "
"abertas. Janelas maximizadas param acima dele."

#: gnomeCustom@gfiamoncini.com/prefs/pages/dock.js:30
#: gnomeCustom@gfiamoncini.com/schemas/org.gnome.shell.extensions.gnomecustom.dock.gschema.xml:13
msgid "Maximum icon size"
msgstr "Tamanho máximo dos ícones"

#: gnomeCustom@gfiamoncini.com/prefs/pages/dock.js:31
msgid "In pixels; icons shrink when there are too many to fit"
msgstr "Em pixels; os ícones diminuem quando não cabem todos"

#: gnomeCustom@gfiamoncini.com/prefs/pages/dock.js:38
msgid "Maximum length"
msgstr "Comprimento máximo"

#: gnomeCustom@gfiamoncini.com/prefs/pages/dock.js:39
msgid "Fraction of the monitor width"
msgstr "Fração da largura do monitor"

#: gnomeCustom@gfiamoncini.com/prefs/pages/dock.js:49
msgid "0 is fully transparent"
msgstr "0 é totalmente transparente"

#: gnomeCustom@gfiamoncini.com/prefs/pages/overview.js:20
#: gnomeCustom@gfiamoncini.com/prefs/pages/overview.js:25
msgid "Overview"
msgstr "Visão geral"

#: gnomeCustom@gfiamoncini.com/prefs/pages/overview.js:26
msgid ""
"Adjustments to the Activities overview. Each one can be turned off on its "
"own."
msgstr ""
"Ajustes na visão geral de Atividades. Cada um pode ser desligado "
"separadamente."

#: gnomeCustom@gfiamoncini.com/prefs/pages/overview.js:30
msgid "Always show workspace thumbnails"
msgstr "Sempre mostrar as miniaturas dos espaços de trabalho"

#: gnomeCustom@gfiamoncini.com/prefs/pages/overview.js:31
msgid "Even with a single workspace"
msgstr "Mesmo com um só espaço de trabalho"

#: gnomeCustom@gfiamoncini.com/prefs/pages/overview.js:36
msgid "Wallpaper behind the thumbnails"
msgstr "Papel de parede atrás das miniaturas"

#: gnomeCustom@gfiamoncini.com/prefs/pages/overview.js:37
msgid "Instead of a plain grey background"
msgstr "No lugar do fundo cinza"

#: gnomeCustom@gfiamoncini.com/prefs/pages/overview.js:42
#: gnomeCustom@gfiamoncini.com/schemas/org.gnome.shell.extensions.gnomecustom.overview.gschema.xml:23
msgid "Hide the search entry until typing"
msgstr "Esconder a caixa de busca até digitar"

#: gnomeCustom@gfiamoncini.com/prefs/pages/overview.js:43
msgid "It appears as soon as you start typing"
msgstr "Ela aparece assim que você começa a digitar"

#: gnomeCustom@gfiamoncini.com/prefs/pages/overview.js:48
msgid "Show Firefox picture-in-picture windows"
msgstr "Mostrar as janelas picture-in-picture do Firefox"

#: gnomeCustom@gfiamoncini.com/prefs/pages/overview.js:49
msgid "GNOME leaves them out of the overview"
msgstr "O GNOME as deixa fora da visão geral"

#: gnomeCustom@gfiamoncini.com/prefs/pages/animation.js:25
msgid "Animation"
msgstr "Animação"

#: gnomeCustom@gfiamoncini.com/prefs/pages/animation.js:34
msgid "Animation speed"
msgstr "Velocidade das animações"

#: gnomeCustom@gfiamoncini.com/prefs/pages/animation.js:35
msgid "Values below 1 make the Shell animations faster; above 1, slower."
msgstr "Valores abaixo de 1 deixam as animações do Shell mais rápidas; acima de 1, mais lentas."

#: gnomeCustom@gfiamoncini.com/prefs/pages/animation.js:39
msgid "Animations are turned off in the system"
msgstr "As animações estão desligadas no sistema"

#: gnomeCustom@gfiamoncini.com/prefs/pages/animation.js:40
msgid ""
"The speed only affects the few animations GNOME always shows. Animations can "
"be turned on in the Accessibility settings."
msgstr "A velocidade só afeta as poucas animações que o GNOME sempre mostra. As animações podem ser ligadas nas configurações de Acessibilidade."

#: gnomeCustom@gfiamoncini.com/prefs/pages/animation.js:47
msgid "Speed factor"
msgstr "Fator de velocidade"

#: gnomeCustom@gfiamoncini.com/prefs/pages/animation.js:86
#, javascript-format
msgid "%s× faster"
msgstr "%s× mais rápidas"

#: gnomeCustom@gfiamoncini.com/prefs/pages/animation.js:87
#, javascript-format
msgid "%s× slower"
msgstr "%s× mais lentas"

#: gnomeCustom@gfiamoncini.com/prefs/pages/animation.js:88
msgid "Normal speed"
msgstr "Velocidade normal"

#: gnomeCustom@gfiamoncini.com/prefs/pages/advanced.js:49
msgid "Advanced"
msgstr "Avançado"

#: gnomeCustom@gfiamoncini.com/prefs/pages/advanced.js:68
msgid "Extensions being replaced"
msgstr "Extensões em substituição"

#: gnomeCustom@gfiamoncini.com/prefs/pages/advanced.js:69
msgid ""
"GnomeCustom never disables anything on its own. While both are active, the "
"two implementations compete for the same feature."
msgstr ""
"O GnomeCustom nunca desativa nada por conta própria. Enquanto as duas "
"estiverem ativas, as duas implementações disputam a mesma funcionalidade."

#: gnomeCustom@gfiamoncini.com/prefs/pages/advanced.js:87
msgid "Conflict: this feature is already provided by GnomeCustom"
msgstr "Conflito: esta funcionalidade já é fornecida pelo GnomeCustom"

#: gnomeCustom@gfiamoncini.com/prefs/pages/advanced.js:88
