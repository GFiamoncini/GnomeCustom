#: gnomeCustom@gfiamoncini.com/prefs/widgets.js:335
msgid "Disabled"
msgstr "Desativado"

#: gnomeCustom@gfiamoncini.com/prefs/widgets.js:342
msgid "Restore default"
msgstr "Restaurar padrão"

#: gnomeCustom@gfiamoncini.com/prefs/widgets.js:348
msgid "Disable shortcut"
msgstr "Desativar atalho"

#: gnomeCustom@gfiamoncini.com/prefs/widgets.js:366
#, javascript-format
msgid "Also used by “%s” (%s)"
msgstr "Também usado por “%s” (%s)"

#: gnomeCustom@gfiamoncini.com/prefs/widgets.js:383
msgid "Press the new shortcut. Esc cancels, Backspace disables."
msgstr "Pressione o novo atalho. Esc cancela, Backspace desativa."

#: gnomeCustom@gfiamoncini.com/prefs/widgets.js:385
#: gnomeCustom@gfiamoncini.com/prefs/pages/general.js:137
msgid "Cancel"
msgstr "Cancelar"

#: gnomeCustom@gfiamoncini.com/prefs/widgets.js:394
msgid ""
"Use Ctrl, Alt or Super with the key (function and media keys work alone)."
msgstr ""
"Use Ctrl, Alt ou Super com a tecla (teclas de função e de mídia valem "
"sozinhas)."

#: gnomeCustom@gfiamoncini.com/prefs/pages/general.js:23
msgid "Silent"
msgstr "Silencioso"

#: gnomeCustom@gfiamoncini.com/prefs/pages/general.js:24
msgid "Errors only"
msgstr "Apenas erros"

#: gnomeCustom@gfiamoncini.com/prefs/pages/general.js:25
msgid "Warnings"
msgstr "Avisos"

#: gnomeCustom@gfiamoncini.com/prefs/pages/general.js:26
msgid "Info"
msgstr "Informação"

#: gnomeCustom@gfiamoncini.com/prefs/pages/general.js:27
msgid "Debug"
msgstr "Depuração"

#: gnomeCustom@gfiamoncini.com/prefs/pages/general.js:51
msgid "General"
msgstr "Geral"

#: gnomeCustom@gfiamoncini.com/prefs/pages/general.js:74
#: gnomeCustom@gfiamoncini.com/prefs/pages/general.js:86
msgid "Profile"
msgstr "Perfil"

#: gnomeCustom@gfiamoncini.com/prefs/pages/general.js:75
msgid "Turns modules on or off and picks a theme in one step."
msgstr "Liga ou desliga módulos e escolhe um tema de uma vez."

#: gnomeCustom@gfiamoncini.com/prefs/pages/general.js:83
#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:57
msgid "Custom"
msgstr "Personalizado"

#: gnomeCustom@gfiamoncini.com/prefs/pages/general.js:96
msgid "Your own combination of modules and settings"
msgstr "A sua própria combinação de módulos e ajustes"

#: gnomeCustom@gfiamoncini.com/prefs/pages/general.js:134
msgid "Original extensions are still active"
msgstr "Extensões originais ainda estão ativas"

#: gnomeCustom@gfiamoncini.com/prefs/pages/general.js:135
#, javascript-format
msgid ""
"%s would run alongside the modules that replace them. Disable them in the "
"Extensions app first, or apply anyway and disable them afterwards."
msgstr ""
"%s rodariam junto com os módulos que as substituem. Desative-as antes no "
"aplicativo Extensões, ou aplique assim mesmo e desative-as depois."

#: gnomeCustom@gfiamoncini.com/prefs/pages/general.js:138
msgid "Apply anyway"
msgstr "Aplicar assim mesmo"

#: gnomeCustom@gfiamoncini.com/prefs/pages/general.js:156
msgid "Modules"
msgstr "Módulos"

#: gnomeCustom@gfiamoncini.com/prefs/pages/general.js:157
msgid ""
"Each module can be turned on or off on its own. Turning the extension off "
"restores the previous state of GNOME."
msgstr ""
"Cada módulo pode ser ativado ou desativado individualmente. Desativar a "
"extensão restaura o estado anterior do GNOME."

#: gnomeCustom@gfiamoncini.com/prefs/pages/general.js:170
#, javascript-format
msgid "not implemented yet, arrives in phase %d"
msgstr "ainda não implementado, chega na fase %d"

#: gnomeCustom@gfiamoncini.com/prefs/pages/general.js:192
msgid "Logging"
msgstr "Registro"

#: gnomeCustom@gfiamoncini.com/prefs/pages/general.js:193
msgid "Messages are written to the systemd journal, tagged [GnomeCustom]."
msgstr ""
"As mensagens são gravadas no journal do systemd, com o marcador "
"[GnomeCustom]."

#: gnomeCustom@gfiamoncini.com/prefs/pages/general.js:201
msgid "Detail level"
msgstr "Nível de detalhe"

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:25
#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:451
#: gnomeCustom@gfiamoncini.com/lib/modules-info.js:37
msgid "Theme"
msgstr "Tema"

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:49
msgid "Preset"
msgstr "Predefinição"

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:50
msgid ""
"A starting point for every surface at once. Changing any option below turns "
"it into a custom look."
msgstr ""
"Um ponto de partida para todas as superfícies de uma vez. Mudar qualquer "
"opção abaixo transforma o visual em personalizado."

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:60
msgid "Look"
msgstr "Visual"

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:71
msgid "Your own combination of the options below"
msgstr "A sua própria combinação das opções abaixo"

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:100
msgid "Menus, notifications and OSD"
msgstr "Menus, notificações e OSD"

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:101
msgid ""
"Extends the shared colours to the pop-up menus and the volume and brightness "
"displays. Each one keeps the look of the shell theme until turned on."
msgstr ""
"Estende as cores compartilhadas aos menus e aos avisos de volume e brilho. "
"Cada um mantém a aparência do tema do Shell até ser ligado."

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:105
msgid "Style popup menus"
msgstr "Estilizar os menus"

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:106
msgid "Panel menus, the logo menu, the applications menu and the cards"
msgstr "Menus do painel, o menu do logotipo, o menu de aplicações e os cartões"

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:111
msgid "Style on-screen displays"
msgstr "Estilizar os avisos na tela (OSD)"

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:112
msgid "Volume and brightness pop-ups; the level bar takes the accent"
msgstr "Avisos de volume e brilho; a barra de nível usa a cor de destaque"

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:117
msgid "Compact notifications"
msgstr "Notificações compactas"

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:118
msgid "Smaller cards in the notification list of the date menu"
msgstr "Cartões menores na lista de notificações do menu da data"

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:123
#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:157
#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:229
msgid "Corner radius"
msgstr "Raio dos cantos"

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:124
msgid "Menus, cards and on-screen displays"
msgstr "Menus, cartões e avisos na tela"

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:133
msgid "Opacity"
msgstr "Opacidade"

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:146
#: gnomeCustom@gfiamoncini.com/prefs/pages/dock.js:20
#: gnomeCustom@gfiamoncini.com/prefs/pages/dock.js:25
#: gnomeCustom@gfiamoncini.com/lib/modules-info.js:117
msgid "Dock"
msgstr "Dock"

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:147
msgid "Shape here; size, position and opacity are on the Dock page."
msgstr "Aqui fica a forma; tamanho, posição e opacidade estão na página Dock."

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:151
msgid "Style the dock"
msgstr "Estilizar o dock"

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:152
msgid "Background colour and running indicators from the shared colours"
msgstr ""
"Cor de fundo e indicadores de janelas abertas a partir das cores "
"compartilhadas"

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:172
#: gnomeCustom@gfiamoncini.com/prefs/pages/tiling.js:25
#: gnomeCustom@gfiamoncini.com/modules/tiling/module.js:332
#: gnomeCustom@gfiamoncini.com/lib/modules-info.js:141
msgid "Tiling"
msgstr "Mosaico"

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:173
msgid "Border drawn around the focused window by the tiling module."
msgstr "Borda desenhada em volta da janela em foco pelo módulo de mosaico."

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:177
#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:315
msgid "Border colour"
msgstr "Cor da borda"

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:178
msgid "Clear to follow the accent colour"
msgstr "Limpe para seguir a cor de destaque"

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:185
#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:330
msgid "Border thickness"
msgstr "Espessura da borda"

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:192
msgid "Window corner radius"
msgstr "Raio dos cantos das janelas"

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:193
msgid ""
"The border follows it. Too small leaves a gap at the corners: 15 fits GNOME "
"apps, 18 also covers Chrome"
msgstr ""
"A borda acompanha esse raio. Pequeno demais deixa uma fresta nos cantos: 15 "
"serve para os apps do GNOME, 18 cobre também o Chrome"

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:206
#: gnomeCustom@gfiamoncini.com/prefs/pages/bluetooth.js:25
#: gnomeCustom@gfiamoncini.com/prefs/pages/media.js:146
msgid "Top bar"
msgstr "Barra superior"

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:207
msgid ""
"Shape and position of the top bar. “None” leaves the shell theme in charge."
msgstr ""
"Forma e posição da barra superior. “Nenhum” deixa o tema do Shell no comando."

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:211
msgid "Style"
msgstr "Estilo"

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:215
msgid "None"
msgstr "Nenhum"

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:216
msgid "Attached to the edge"
msgstr "Encostada na borda"

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:217
msgid "Floating"
msgstr "Flutuante"

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:221
msgid "Height"
msgstr "Altura"

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:222
#: gnomeCustom@gfiamoncini.com/prefs/pages/menu.js:53
msgid "In pixels"
msgstr "Em pixels"

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:230
msgid "Attached to the edge, only the bottom corners are rounded"
msgstr "Colada à borda, só os cantos de baixo são arredondados"

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:239
#: gnomeCustom@gfiamoncini.com/prefs/pages/panel.js:42
msgid "Icon size"
msgstr "Tamanho dos ícones"

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:240
msgid "Status icons, in pixels; 16 is the GNOME size, whatever the shell theme"
msgstr ""
"Ícones de status, em pixels; 16 é o tamanho do GNOME, qualquer que seja o "
"tema do Shell"

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:247
msgid "Space above"
msgstr "Espaço acima"

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:256
msgid "Space below"
msgstr "Espaço abaixo"

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:265
msgid "Space at the sides"
msgstr "Espaço nas laterais"

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:274
msgid "Full-height panel buttons"
msgstr "Botões com a altura toda da barra"

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:275
msgid "Removes the padding above and below buttons so they fill the bar"
msgstr ""
"Remove o espaçamento acima e abaixo dos botões, para que ocupem a barra "
"inteira"

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:290
msgid "Top bar colours"
msgstr "Cores da barra superior"

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:291
msgid ""
"Turn on to pick the bar colours yourself. Off, the bar follows the shared "
"colours below (wallpaper palette or background colour)."
msgstr ""
"Ligue para escolher você mesmo as cores da barra. Desligado, a barra segue "
"as cores compartilhadas abaixo (paleta do papel de parede ou cor de fundo)."

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:295
msgid "Choose the bar colours"
msgstr "Escolher as cores da barra"

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:296
msgid "Background, opacity and border, independent of the shell theme"
msgstr "Fundo, opacidade e borda, independentes do tema do Shell"

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:304
#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:371
msgid "Background colour"
msgstr "Cor de fundo"

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:310
#: gnomeCustom@gfiamoncini.com/prefs/pages/dock.js:48
msgid "Background opacity"
msgstr "Opacidade do fundo"

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:316
msgid "Clear for a shade of the background"
msgstr "Limpe para usar um tom do fundo"

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:323
#: gnomeCustom@gfiamoncini.com/schemas/org.gnome.shell.extensions.gnomecustom.theme.gschema.xml:65
msgid "Border opacity"
msgstr "Opacidade da borda"

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:331
msgid "0 removes the border"
msgstr "0 remove a borda"

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:346
msgid "Shared colours"
msgstr "Cores compartilhadas"

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:347
msgid ""
"Base for menus, OSD and dock, and for the bar when its own colours are off. "
"With the wallpaper palette on, the colour comes from the desktop background; "
"a background colour overrides it."
msgstr ""
"Base para menus, OSD e dock, e para a barra quando as cores próprias dela "
"estão desligadas. Com a paleta do papel de parede ligada, a cor vem da "
"imagem da área de trabalho; uma cor de fundo tem precedência."

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:351
msgid "Take colours from the wallpaper"
msgstr "Usar as cores do papel de parede"

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:356
msgid "Palette colour to use"
msgstr "Cor da paleta a usar"

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:357
msgid "0 is the most frequent colour of the wallpaper"
msgstr "0 é a cor mais frequente do papel de parede"

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:364
#: gnomeCustom@gfiamoncini.com/schemas/org.gnome.shell.extensions.gnomecustom.theme.gschema.xml:97
msgid "Accent colour"
msgstr "Cor de destaque"

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:365
msgid "Highlights and open menus"
msgstr "Destaques e menus abertos"

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:372
msgid "Clear to go back to the wallpaper palette"
msgstr "Limpe para voltar à paleta do papel de parede"

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:379
msgid "Text colour"
msgstr "Cor do texto"

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:380
msgid "Clear to pick automatically for contrast"
msgstr "Limpe para escolher automaticamente por contraste"

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:389
msgid "Current wallpaper palette"
msgstr "Paleta do papel de parede atual"

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:390
msgid "Extracted automatically, most frequent colour first"
msgstr "Extraída automaticamente, da cor mais frequente para a menos"

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:416
msgid "No palette yet"
msgstr "Ainda sem paleta"

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:417
msgid "It is extracted when the Theme module is enabled"
msgstr "É extraída quando o módulo Tema é ativado"

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:427
msgid "most frequent"
msgstr "mais frequente"

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:437
msgid "Shell theme"
msgstr "Tema do Shell"

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:438
msgid ""
"Loads a theme from ~/.themes, the job the User Themes extension does. The "
"generated bar style is applied on top of it."
msgstr ""
"Carrega um tema de ~/.themes, o papel da extensão User Themes. O estilo "
"gerado para a barra é aplicado por cima dele."

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:444
msgid "Default GNOME theme"
msgstr "Tema padrão do GNOME"

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:448
msgid "(not installed)"
msgstr "(não instalado)"

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:457
msgid "Use it for applications too"
msgstr "Usar também nos aplicativos"

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:458
msgid ""
"When the theme also ships a GTK theme (like Dracula-AMOLED), the apps follow "
"it, libadwaita ones included, and VS Code, Obsidian and GitHub Desktop get "
"its colours or the system window frame. Turning this off restores the "
"previous look; apps need to be reopened"
msgstr ""
"Quando o tema também traz um tema GTK (como o Dracula-AMOLED), os "
"aplicativos o seguem, inclusive os libadwaita, e o VS Code, o Obsidian e o "
"GitHub Desktop ganham as cores dele ou a moldura do sistema. Desligar "
"devolve o visual anterior; os aplicativos precisam ser reabertos"

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:463
#: gnomeCustom@gfiamoncini.com/schemas/org.gnome.shell.extensions.gnomecustom.theme.gschema.xml:197
msgid "AMOLED black"
msgstr "Preto AMOLED"

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:464
msgid ""
"Dark greys of the theme become pure black, for OLED screens; text and accent "
"stay"
msgstr ""
"Os cinzas escuros do tema viram preto puro, para telas OLED; texto e "
"destaque não mudam"

#: gnomeCustom@gfiamoncini.com/prefs/pages/theme.js:471
msgid "Could not list installed themes"
msgstr "Não foi possível listar os temas instalados"

