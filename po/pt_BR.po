msgstr "Usado para executar cada importação de configuração apenas uma vez."

#: gnomeCustom@gfiamoncini.com/schemas/org.gnome.shell.extensions.gnomecustom.gschema.xml:92
msgid "Settings saved before the last import"
msgstr "Configurações salvas antes da última importação"

#: gnomeCustom@gfiamoncini.com/schemas/org.gnome.shell.extensions.gnomecustom.gschema.xml:93
msgid "JSON snapshot used by “Undo last import”. Not meant to be edited."
msgstr ""
"Foto em JSON usada por “Desfazer a última importação”. Não se destina a "
"edição manual."

#: gnomeCustom@gfiamoncini.com/schemas/org.gnome.shell.extensions.gnomecustom.gschema.xml:98
