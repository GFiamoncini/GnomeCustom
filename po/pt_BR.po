msgstr "Mensagens abaixo deste nível não são gravadas no journal."

#: gnomeCustom@gfiamoncini.com/schemas/org.gnome.shell.extensions.gnomecustom.gschema.xml:87
msgid "Migration version already applied"
msgstr "Versão da migração já aplicada"

#: gnomeCustom@gfiamoncini.com/schemas/org.gnome.shell.extensions.gnomecustom.gschema.xml:88
